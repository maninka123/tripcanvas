# Optional server configuration. TripCanvas runs without any of these.
# For local development copy the ones you need into .dev.vars (git-ignored).
# In production set them as secrets in the hosting platform.

# Enables the AI planning assistant (Anthropic Claude).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Self-hosted or commercial providers (defaults are free public services).
# PLACES_BASE_URL=https://photon.komoot.io
# ROUTING_BASE_URL=https://valhalla1.openstreetmap.de

# Contact sent in the User-Agent to open-data providers.
# PROVIDER_CONTACT=https://github.com/maninka123/tripcanvas
